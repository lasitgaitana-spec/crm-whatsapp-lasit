# Variables de entorno para server/ (copiar como .env y ajustar)

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=crm_whatsapp

# Almacenamiento
# Directorio base para guardar media descargada
STORAGE_DIR=storage

# Eliminado: variables de Telegram

# Nota: CORS está definido en código para http://localhost:5173 y otros puertos dev.
# No exponga este .env en control de versiones con secretos reales.

# Respuestas automáticas (origen)
# Valores: frontend | backend | off/disabled
# Por defecto recomendamos `frontend` para evitar respuestas duplicadas.
WA_AUTOREPLY_SOURCE=frontend
WA_BACKEND_SENDING_ENABLED=false
 
# Simulación de "escribiendo" para /api/wa/send cuando simulateTyping=true
# Ritmo por palabra (ms) y tope máximo (ms)
WA_TYPING_PER_WORD_MS=5000
WA_TYPING_DELAY_MAX_MS=120000